{
  "name": "e-store-extension-canada",
  "description": "NutriLens - Open Food Facts scores (Nutri-Score, Eco-Score, NOVA) overlaid on Canadian online grocery stores",
  "private": true,
  "license": "MIT",
  "author": "Open Food Facts Canada contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/offCanada/e-store-extension-canada.git"
  },
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.11",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-preact": "^1.28.0",
    "preact": "^10.29.0",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
